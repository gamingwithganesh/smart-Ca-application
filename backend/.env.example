PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ca-document-system
JWT_SECRET=your_jwt_secret_key_here
BASE_URL=http://localhost:5000

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AWS Configuration for Lex v2 (Get these from AWS setup guide below)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# AWS Lex Configuration
LEX_BOT_ID=your_lex_bot_id
LEX_BOT_ALIAS_ID=TSTALIASID
LEX_LOCALE_ID=en_US

# AWS S3 Configuration for Document Storage
AWS_S3_BUCKET_NAME=your-ca-documents-bucket

# Supabase Configuration (Legacy - can be removed if fully migrated to S3)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key